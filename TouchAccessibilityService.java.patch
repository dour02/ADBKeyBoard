+    /**
+     * Copy all text exposed by the active window's AccessibilityNodeInfo tree.
+     * This is intentionally independent of InputConnection and the focused editor.
+     * Android has no universal API that visually selects every widget in every app;
+     * this action copies the text the app exposes to accessibility services.
+     */
+    private void copyActiveWindowText() {
+        AccessibilityNodeInfo root = null;
+        try {
+            root = getRootInActiveWindow();
+            if (root == null) {
+                Log.w("AdbTouch", "ADB_SELECT_ALL_COPY: active window has no accessibility root");
+                return;
+            }
+
+            StringBuilder text = new StringBuilder();
+            int[] visited = new int[] {0};
+            collectAccessibleText(root, text, visited, 0);
+
+            String result = text.toString().trim();
+            if (result.isEmpty()) {
+                Log.w("AdbTouch", "ADB_SELECT_ALL_COPY: no accessible text in active window");
+                return;
+            }
+
+            ClipboardManager clipboard =
+                    (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
+            if (clipboard == null) {
+                Log.e("AdbTouch", "ADB_SELECT_ALL_COPY: ClipboardManager unavailable");
+                return;
+            }
+            clipboard.setPrimaryClip(ClipData.newPlainText("ADBKeyBoard", result));
+            Log.i("AdbTouch", "ADB_SELECT_ALL_COPY: copied " + result.length()
+                    + " chars from " + visited[0] + " accessibility nodes");
+        } catch (Throwable e) {
+            Log.e("AdbTouch", "ADB_SELECT_ALL_COPY failed", e);
+        } finally {
+            if (root != null) {
+                try {
+                    root.recycle();
+                } catch (Throwable ignored) {
+                }
+            }
+        }
+    }
+
+    private void collectAccessibleText(
+            AccessibilityNodeInfo node,
+            StringBuilder out,
+            int[] visited,
+            int depth
+    ) {
+        if (node == null || visited[0] >= COPY_MAX_NODES
+                || depth > 80 || out.length() >= COPY_MAX_CHARS) {
+            return;
+        }
+        visited[0]++;
+
+        if (node.isVisibleToUser() && !node.isPassword()) {
+            CharSequence nodeText = node.getText();
+            CharSequence description = node.getContentDescription();
+            appendAccessibleText(nodeText, out);
+            if (description != null
+                    && (nodeText == null || !description.toString().contentEquals(nodeText))) {
+                appendAccessibleText(description, out);
+            }
+        }
+
+        int childCount = node.getChildCount();
+        for (int i = 0; i < childCount; i++) {
+            if (visited[0] >= COPY_MAX_NODES || out.length() >= COPY_MAX_CHARS) {
+                break;
+            }
+            AccessibilityNodeInfo child = null;
+            try {
+                child = node.getChild(i);
+                if (child != null) {
+                    collectAccessibleText(child, out, visited, depth + 1);
+                }
+            } catch (Throwable e) {
+                Log.w("AdbTouch", "Unable to read accessibility child", e);
+            } finally {
+                if (child != null) {
+                    try {
+                        child.recycle();
+                    } catch (Throwable ignored) {
+                    }
+                }
+            }
+        }
+    }
+
+    private void appendAccessibleText(CharSequence value, StringBuilder out) {
+        if (value == null || out.length() >= COPY_MAX_CHARS) {
+            return;
+        }
+        String item = value.toString().replace('\u0000', ' ').trim();
+        if (item.isEmpty()) {
+            return;
+        }
+
+        // Avoid adding the same value twice when a parent and child expose it.
+        if (out.length() >= item.length()
+                && out.substring(out.length() - item.length()).equals(item)) {
+            return;
+        }
+
+        if (out.length() > 0) {
+            out.append('\n');
+        }
+        int remaining = COPY_MAX_CHARS - out.length();
+        if (item.length() > remaining) {
+            item = item.substring(0, remaining);
+        }
+        out.append(item);
+    }
+
+    private static float c(float v) {
