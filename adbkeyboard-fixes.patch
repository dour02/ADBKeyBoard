+          SIGNING_KEY_ALIAS: ${{ secrets.SIGNING_KEY_ALIAS }}
+          SIGNING_KEY_PASSWORD: ${{ secrets.SIGNING_KEY_PASSWORD }}
+        run: |
+          chmod +x gradlew
+          if [ "${{ steps.keystore.outputs.signed }}" = "true" ]; then
+            ./gradlew --no-daemon assembleDebug assembleRelease
+          else
+            ./gradlew --no-daemon assembleDebug
+          fi
+
+      - name: Collect APKs
+        run: |
+          mkdir -p out
+          cp keyboardservice/build/outputs/apk/debug/*.apk "out/ADBKeyboard-${VERSION_NAME}-debug.apk"
+          if [ "${{ steps.keystore.outputs.signed }}" = "true" ]; then
+            cp keyboardservice/build/outputs/apk/release/*.apk "out/ADBKeyboard-${VERSION_NAME}.apk"
+          fi
+          ls -l out
+
+      - name: Upload artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ADBKeyboard-${{ env.VERSION_NAME }}
+          path: out/*.apk
+
+      - name: Publish release
+        if: startsWith(github.ref, 'refs/tags/v')
+        uses: softprops/action-gh-release@v2
+        with:
+          files: out/*.apk
+          generate_release_notes: true
