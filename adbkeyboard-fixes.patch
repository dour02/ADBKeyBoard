@@ -1,15 +1,58 @@
 apply plugin: 'com.android.application'
 
+// 签名信息从环境变量读取（GitHub Actions 里由 Secrets 注入），本地没设置时 release 包不签名
+def ksFile = System.getenv('SIGNING_STORE_FILE')
+def hasSigning = ksFile != null && file(ksFile).exists()
+
 android {
     namespace 'com.android.adbkeyboard'
     compileSdk 33
 
     defaultConfig {
         applicationId 'com.android.adbkeyboard'
-        minSdk 24
+        minSdk 24          // dispatchGesture 需要 API 24
         targetSdk 33
-        versionCode 2
-        versionName "2.0"
+        // CI 里用运行序号做 versionCode，保证每次构建都能覆盖安装
+        versionCode((System.getenv('VERSION_CODE') ?: '2') as int)
+        versionName System.getenv('VERSION_NAME') ?: '2.0'
+    }
+
+    signingConfigs {
+        if (hasSigning) {
+            release {
+                storeFile file(ksFile)
+                storePassword System.getenv('SIGNING_STORE_PASSWORD')
+                keyAlias System.getenv('SIGNING_KEY_ALIAS')
+                keyPassword System.getenv('SIGNING_KEY_PASSWORD')
+                enableV1Signing true
+                enableV2Signing true
+            }
+        }
+    }
+
+    buildTypes {
+        // CI 每次都会生成新的随机 debug 签名，导致新包无法覆盖安装旧包；
+        // 配了正式签名后 debug 包也用同一把 key
+        debug {
+            if (hasSigning) {
+                signingConfig signingConfigs.release
+            }
+        }
+        release {
+            minifyEnabled false
+            if (hasSigning) {
+                signingConfig signingConfigs.release
+            }
+        }
+    }
+
+    compileOptions {
+        sourceCompatibility JavaVersion.VERSION_1_8
+        targetCompatibility JavaVersion.VERSION_1_8
+    }
+
+    lint {
+        abortOnError false
     }
 }
 
