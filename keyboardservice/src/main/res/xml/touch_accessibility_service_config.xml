<?xml version="1.0" encoding="utf-8"?>
<!-- typeWindowStateChanged：手势注入用不到事件，保留一个低频类型即可
     typeNotificationStateChanged：toast 监听需要（toast 以通知状态变化事件送达） -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/touch_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:accessibilityFlags="flagDefault" />
