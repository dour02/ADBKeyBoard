<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="#444"
    >
    <!-- 显示条高度由这行文字决定 -->
    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
    	android:layout_height="wrap_content"
    	android:text="@string/keyboard_on"
    	android:layout_centerInParent="true"
    	android:textColor="#fff"
    />

    <!-- 上下边对齐文字，不会撑高显示条。点击：选择输入法；长按：切换到下一个输入法 -->
    <ImageView
        android:id="@+id/switch_ime"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/label"
        android:layout_alignBottom="@id/label"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_switch_ime"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/switch_ime"
        android:clickable="true"
        android:focusable="false"
    />
</RelativeLayout>
